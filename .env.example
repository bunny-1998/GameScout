# Copy this file to ".env" and fill in your values.
# The .env file stays on your machine / host and is never sent to the browser.

# Data source: mock | appstorespy
DATA_SOURCE=mock

# Your AppstoreSpy API key. Get it at https://appstorespy.com/account
API_KEY=

# Reference market for downloads/revenue estimates (US, GB, DE, IN, PK, ...)
APP_COUNTRY=US
APP_LANGUAGE=en_US

# Port (locally 3000; on a host this is set automatically)
PORT=3000

# ---- Login (only needed when hosting online for your team) ----
# One shared team login:
AUTH_USER=
AUTH_PASS=
# ...or multiple people (comma-separated "user:password"):
# AUTH_USERS=alice:pass1,bob:pass2
# Leave all of these blank to run without a login (fine on your own PC).
